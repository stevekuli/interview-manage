# interview-manage production env — template.
# Copy to /opt/interview-manage/.env on the server and fill in real values.
# Secrets are generated per-install (see docs/acceptance deployment record);
# never commit the filled-in file.

# Public entry of the deployment (subdomain + TLS since 2026-10-25).
# This is the canonical origin: secure cookies, email links and metadata follow it.
APP_URL=https://interview.unlimit.ltd

# Extra origins that may still reach sign-in (comma-separated), e.g. the legacy
# IP entrance. Needed or Better Auth rejects browser POSTs with 403 INVALID_ORIGIN.
# NOTE: APP_URL above is https, so its session cookies are Secure and will NOT be
# stored over plain http — point the legacy entrance at APP_URL via a 301 instead
# of keeping it a parallel login entrance.
TRUSTED_ORIGINS=http://8.148.199.165:3012

# Postgres superuser password for the isolated interview-manage database.
POSTGRES_PASSWORD=change-me

# openssl rand -hex 32
AUTH_SECRET=change-me
ENCRYPTION_SECRET=change-me
